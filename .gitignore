# --- dependencies and build artifacts ---------------------------------------
node_modules/
src-tauri/target/
# regenerated by the build; the capabilities file only points at it
src-tauri/gen/
# scratch output left beside src-tauri's sources by the build
src-tauri/_scratch_*
dist/

# --- dev-session scratch ----------------------------------------------------
# logs, captures, and the saved pre-change copies
*.log
*.out
*.err
*.tmp
*.bak

# --- not source -------------------------------------------------------------
# this session's ledger, plans, specs, and backups
.superpowers/
docs/

# the upstream Strata web app (app.js / page.html) was fetched from the live
# server as reference material - it is not this project's code, and it is not
# mine to publish
app.js
page.html

# --- dev helpers that hardcode the live server's LAN address ----------------
tools/
mock/
tests/live-check.mjs
